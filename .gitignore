# Virtual environments
.venv/
venv/
ENV/

# Python cache & build
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Competition data (Never commit raw/processed data)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Experiment heavy artifacts & OOF predictions
experiments/oof/*
!experiments/oof/.gitkeep
experiments/artifacts/*
!experiments/artifacts/.gitkeep

# Generated submission CSVs (keep logs)
submissions/*.csv
submissions/*.zip

# Secrets & local environment files
.env
.env.*
*.pem
*.key

# OS / IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
